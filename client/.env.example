# Public build-time values. Never put provider secrets in VITE_* settings.
VITE_BACKEND_BASE_URI=http://localhost:4000
VITE_GOOGLE_CLIENT_ID=replace-with-google-client-id
VITE_GITHUB_CLIENT_ID=replace-with-github-client-id
VITE_RZP_KEY_ID=rzp_test_replace_with_key
# Must match the corresponding server RZP_PLAN_* settings.
VITE_RZP_PLAN_PRO_MONTHLY=plan_replace_pro_monthly
VITE_RZP_PLAN_PRO_YEARLY=plan_replace_pro_yearly
VITE_RZP_PLAN_PREMIUM_MONTHLY=plan_replace_premium_monthly
VITE_RZP_PLAN_PREMIUM_YEARLY=plan_replace_premium_yearly
