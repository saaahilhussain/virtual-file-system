# Copy to .env and replace placeholders. Never commit real credentials.
PORT=4000
NODE_ENV=development
CLIENT_URI=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/file-shelter?replicaSet=rs0
REDIS_URI=redis://localhost:6379
SESSION_SECRET=replace-with-a-long-random-secret
AWS_REGION=ap-south-1
S3_BUCKET=replace-with-file-bucket
# Optional for local development. Leave both unset on EC2 to use its IAM role.
# S3_PROFILE_ACCESS_ID=replace-with-access-key
# S3_PROFILE_ACCESS_SECRET=replace-with-secret-key
CLOUDFRONT_DOMAIN=https://replace-with-distribution.cloudfront.net
CLOUDFRONT_PUBLIC_ID=replace-with-key-pair-id
# Quoted PEM with literal \n separators is normalized by cloudFrontService.js.
CLOUDFRONT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-pem-body\n-----END PRIVATE KEY-----"
RESEND_API_KEY=re_replace_with_key
GOOGLE_CLIENT_ID=replace-with-google-client-id
GITHUB_CLIENT_ID=replace-with-github-client-id
GITHUB_CLIENT_SECRET=replace-with-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:5173/auth/github/callback
RZP_KEY_ID=rzp_test_replace_with_key
RZP_KEY_SECRET=replace-with-razorpay-secret
WEBHOOK_SECRET=replace-with-webhook-secret
RZP_PLAN_PRO_MONTHLY=plan_replace_pro_monthly
RZP_PLAN_PRO_YEARLY=plan_replace_pro_yearly
RZP_PLAN_PREMIUM_MONTHLY=plan_replace_premium_monthly
RZP_PLAN_PREMIUM_YEARLY=plan_replace_premium_yearly
