[Unit]
Description=Refresh File Shelter backend .env from encrypted settings
Wants=network-online.target
After=network-online.target
Before=pm2-ubuntu.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
ExecStart=/usr/bin/python3 /usr/local/lib/file-shelter/refresh-runtime-env.py
RemainAfterExit=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/file-shelter/server
Environment=AWS_DEFAULT_REGION=ap-south-1

[Install]
WantedBy=multi-user.target
